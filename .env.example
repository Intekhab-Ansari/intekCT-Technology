# IntekCT Environment Variables Blueprint

# AI Provider API Keys (Optional - Intelligent fallback engine runs automatically if left blank)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Contact Form Integration (Optional - Resend API Key for dispatching lead notifications)
RESEND_API_KEY=re_your_resend_api_key_here
CONTACT_NOTIFICATION_EMAIL=contact@intekct.com

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://intekct.com
NEXT_PUBLIC_CALENDLY_URL=https://cal.com/intekct/project-discovery
